{
  "name": "tre-hanna-backend",
  "version": "0.1.0",
  "description": "Tampere Hanna Backend",
  "main": "src/app.ts",
  "engines": {
    "node": "24.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/app.js",
    "dev": "concurrently 'npm:dev:*'",
    "dev:tsc": "tsc --watch --noEmit --preserveWatchOutput --pretty",
    "dev:server": "tsx watch --clear-screen=false src/app.ts",
    "test": "vitest run",
    "db-migrate": "PGOPTIONS='-c search_path=app,public' tsx src/migration.ts",
    "db-post-migrate": "PGOPTIONS='-c search_path=app,public' tsx src/postMigration.ts",
    "db-migrate:prod": "PGOPTIONS='-c search_path=app,public' node dist/migration.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tampere/Hanna.git"
  },
  "keywords": [
    "Tampere",
    "Project Management",
    "Backend"
  ],
  "author": "Ubigu Oy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tampere/Hanna/issues"
  },
  "homepage": "https://github.com/Tampere/Hanna",
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/email-templates": "^10.0.4",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.24",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "node-dev": "^8.0.0",
    "pino-pretty": "^11.3.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/passport": "^3.0.2",
    "@fastify/sensible": "^6.0.4",
    "@fastify/session": "^11.1.2",
    "@fastify/static": "^9.3.0",
    "@trpc/client": "^10.45.4",
    "@trpc/server": "^10.45.4",
    "axios": "^1.18.1",
    "connect-pg-simple": "^9.0.1",
    "dayjs": "^1.11.21",
    "dotenv": "^16.6.1",
    "email-templates": "^12.0.3",
    "excel4node": "^1.8.2",
    "fast-json-stable-stringify": "^2.1.0",
    "fastify": "^5.10.0",
    "nodemailer": "^9.0.1",
    "openid-client": "^5.7.1",
    "pg-boss": "^9.0.3",
    "pino": "^9.14.0",
    "postgres-migrations": "^5.3.0",
    "pug": "^3.0.4",
    "server-text-width": "^1.0.2",
    "slonik": "^46.8.0",
    "soap": "^1.10.0",
    "superjson": "^2.2.6",
    "tre-hanna-shared": "file:../shared",
    "zod": "^3.25.76"
  }
}
